## @file
#  UefiMemDump UEFI driver module definition.
#
#  Produces a pre-exit-boot-services memory acquisition to USB media
#  and emits memory map + loaded image metadata for offline analysis.
#
##
[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = UefiMemDump
  FILE_GUID                      = 238781de-f4c2-11ee-9841-000c2983bc1b
  MODULE_TYPE                    = UEFI_DRIVER
  VERSION_STRING                 = 1.0
  ENTRY_POINT                    = UefiMemDumpDriverEntryPoint
  UNLOAD_IMAGE                   = UefiMemDumpUnload


[Sources]
  UefiMemDump.h
  UefiMemDump.c
  UefiImageList.h
  UefiImageList.c

[Packages]
  MdePkg/MdePkg.dec
  MdeModulePkg/MdeModulePkg.dec

[LibraryClasses]
  UefiDriverEntryPoint
  UefiBootServicesTableLib
  UefiRuntimeServicesTableLib
  UefiLib
  MemoryAllocationLib
  BaseMemoryLib
  BaseLib
  PrintLib
  DevicePathLib
  DebugLib
  PcdLib

[Protocols]
  gEfiDriverBindingProtocolGuid
  gEfiSimpleFileSystemProtocolGuid
  gEfiLoadedImageProtocolGuid
  gEfiBlockIoProtocolGuid

[Guids]
  gEfiEventBeforeExitBootServicesGuid
  gEfiEventReadyToBootGuid

[Depex]
  TRUE
