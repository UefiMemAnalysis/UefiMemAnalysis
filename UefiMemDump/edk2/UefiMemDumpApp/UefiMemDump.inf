## @file
#  UefiMemDump UEFI application module definition.
#
#  Writes memory artifacts to the same filesystem device that loaded the app:
#  - \Dump\ImageList.txt
#  - \Dump\Memory_Map.txt
#  - \Dump\dump*.bin
##

[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = UefiMemDump
  FILE_GUID                      = 238781de-f4c2-11ee-9841-000c2983bc1a
  MODULE_TYPE                    = UEFI_APPLICATION
  VERSION_STRING                 = 1.0
  ENTRY_POINT                    = UefiMain

#
#  This flag specifies whether HII resource section is generated into PE image.
#
  UEFI_HII_RESOURCE_SECTION      = TRUE

#
# The following information is for reference only and not required by the build tools.
#
#  VALID_ARCHITECTURES           = IA32 X64 EBC
#

[Sources]
  UefiMemDump.h
  UefiMemDump.c
  UefiImageList.h
  UefiImageList.c

[Packages]
  MdePkg/MdePkg.dec
  MdeModulePkg/MdeModulePkg.dec

[LibraryClasses]
  UefiApplicationEntryPoint
  UefiLib
  PcdLib
  DebugLib
  BaseLib
  BaseMemoryLib
  MemoryAllocationLib
  PrintLib
  DevicePathLib

[Protocols]
  gEfiLoadedImageProtocolGuid
  gEfiSimpleFileSystemProtocolGuid
